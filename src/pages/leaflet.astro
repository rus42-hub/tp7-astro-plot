---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carte des établissements">
  <h1 class="text-3xl font-bold">Carte des établissements</h1>
  <p class="mt-3 text-slate-700">Localisation des établissements en France.</p>

  <div
    id="map"
    class="mt-6 overflow-hidden rounded-xl border border-slate-300"
    style="height: 600px;"
    role="region"
    aria-label="Carte interactive des établissements en France"
  ></div>
</Layout>

<script>
  import listeEtablissements from "../assets/listeEtablissements.json";
  import L from "leaflet";

  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);

  listeEtablissements.forEach((etablissement) => {
    const popup = document.createElement("span");
    popup.textContent = etablissement.name;

    L.marker([etablissement.lat, etablissement.lon])
      .addTo(map)
      .bindPopup(popup);
  });
</script>
